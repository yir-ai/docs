{
  "name": "@yir/docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm exec blume dev",
    "build": "pnpm exec blume build && node ./scripts/prepare-site.mjs && node ./scripts/check-public-boundary.mjs --artifact ./dist",
    "check": "pnpm exec blume check",
    "preview": "pnpm exec blume preview",
    "check:public": "node ./scripts/check-public-boundary.mjs",
    "publish:check": "pnpm run check:public && pnpm run test && pnpm run validate",
    "generate:models": "node ./scripts/generate-model-pages.mjs",
    "localize:openapi": "node ./scripts/localize-openapi.mjs",
    "test": "node --test ./scripts/*.test.mjs",
    "validate": "pnpm exec blume validate"
  },
  "devDependencies": {
    "blume": "2.0.3"
  },
  "packageManager": "pnpm@10.26.1"
}
