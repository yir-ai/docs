{
  "name": "@yir/docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm exec blume build && node ./scripts/prepare-origin-release.mjs",
    "check": "pnpm exec blume check",
    "origin:smoke": "node ./scripts/origin-nginx-smoke.mjs",
    "preview": "pnpm exec blume preview",
    "release:verify": "node ./scripts/origin-release.mjs verify --artifact ./dist",
    "sync:openapi": "node ./scripts/sync-openapi.mjs",
    "publish:check": "pnpm run test && pnpm run validate",
    "test": "node --test ./scripts/*.test.mjs",
    "validate": "pnpm exec blume validate"
  },
  "devDependencies": {
    "blume": "1.5.1"
  },
  "packageManager": "pnpm@10.26.1"
}
