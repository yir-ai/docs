index 0000000000000000000000000000000000000000..c2ccf16ea0883387e33ea73ea1735f9e91881382
--- /dev/null
+++ b/src/components/openapi/strings.ts
@@ -0,0 +1,88 @@
+/**
+ * Labels of the API reference chrome, per page locale. The English set is the
+ * baseline; a locale pack overrides any subset and falls back per key.
+ */
+const en = {
+  allowed: "Allowed:",
+  anyOf: "Any of",
+  arrayOf: "Array of",
+  authOptional: "Optional — this operation also accepts unauthenticated requests.",
+  authorization: "Authorization",
+  circularReference: "Circular reference to",
+  copied: "Copied",
+  copy: "Copy",
+  default: "default:",
+  deprecated: "deprecated",
+  hideProperties: "Hide properties",
+  matches: "matches",
+  max: "max",
+  maxItems: "max items",
+  maxLength: "max length",
+  min: "min",
+  minItems: "min items",
+  minLength: "min length",
+  notFound: "This API operation could not be found.",
+  oneOf: "One of",
+  or: "or",
+  paramsChannel: "Channel parameters",
+  paramsCookie: "Cookie parameters",
+  paramsHeader: "Header parameters",
+  paramsPath: "Path parameters",
+  paramsQuery: "Query parameters",
+  request: "Request",
+  requestBody: "Request body",
+  required: "required",
+  response: "Response",
+  responses: "Responses",
+  scopes: "Scopes:",
+  showProperties: "Show properties",
+  version: "Version",
+};
+
+export type ReferenceStrings = typeof en;
+
+const packs: Record<string, Partial<ReferenceStrings>> = {
+  zh: {
+    allowed: "可选值：",
+    anyOf: "以下任意一种",
+    arrayOf: "数组，元素为",
+    authOptional: "可选：此接口也接受未认证的请求。",
+    authorization: "认证",
+    circularReference: "循环引用",
+    copied: "已复制",
+    copy: "复制",
+    default: "默认值：",
+    deprecated: "已弃用",
+    hideProperties: "收起属性",
+    matches: "匹配",
+    max: "最大值",
+    maxItems: "最多项数",
+    maxLength: "最大长度",
+    min: "最小值",
+    minItems: "最少项数",
+    minLength: "最小长度",
+    notFound: "找不到此 API 操作。",
+    oneOf: "以下之一",
+    or: "或",
+    paramsChannel: "频道参数",
+    paramsCookie: "Cookie 参数",
+    paramsHeader: "请求头参数",
+    paramsPath: "路径参数",
+    paramsQuery: "查询参数",
+    request: "请求",
+    requestBody: "请求体",
+    required: "必填",
+    response: "响应",
+    responses: "响应",
+    scopes: "权限范围：",
+    showProperties: "展开属性",
+    version: "版本",
+  },
+};
+
+/** The labels for `locale` (e.g. `Astro.currentLocale`), English when unknown. */
+export const referenceStrings = (locale?: string): ReferenceStrings => {
+  const code = locale?.toLowerCase() ?? "";
+  const pack = packs[code] ?? packs[code.split("-")[0] ?? ""] ?? {};
+  return { ...en, ...pack };
+};
