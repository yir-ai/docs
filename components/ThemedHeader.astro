---
import Header from 'blume/components/layout/Header.astro';

// yir.ai 与 Docs 通过 `yir-theme` Cookie 共享明暗偏好（Cookie 不区分端口，本地也能互通）。
// 在顶栏渲染前按 Cookie 修正 Blume 的主题，主题按钮切换时写回 Cookie。
const themeSync = `(()=>{const d=document.documentElement;const m=document.cookie.match(/(?:^|;\\s*)yir-theme=(light|dark|system)(?:;|$)/);if(m){const p=m[1];try{p==="system"?localStorage.removeItem("blume-theme"):localStorage.setItem("blume-theme",p);}catch{}d.dataset.theme=p==="system"?(matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light"):p;}if(window.__yirThemeSync)return;window.__yirThemeSync=true;document.addEventListener("click",(e)=>{if(e.target.closest("[data-blume-theme-toggle]")){setTimeout(()=>{document.cookie="yir-theme="+d.dataset.theme+"; Path=/; Max-Age=31536000; SameSite=Lax";},0);}});})();`;
---

<script is:inline set:html={themeSync} />
<Header {...Astro.props} />
